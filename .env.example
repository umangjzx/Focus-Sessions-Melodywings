# Focus Sessions API Configuration
# Copy this file to .env and update with your actual values

# App Configuration
APP_NAME="Focus Sessions API"
SECRET_KEY="your-secret-key-change-this-in-production-use-32-characters-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL="sqlite:///./focus_sessions.db"
# For PostgreSQL in production, use:
# DATABASE_URL="postgresql+psycopg://user:password@localhost/focus_sessions"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# For production, update to:
# CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Auto-create tables (set to false in production, use migrations instead)
AUTO_CREATE_TABLES=true

# Server Configuration
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
SERVER_RELOAD=true
LOG_LEVEL="info"

# Security (for production)
DISABLE_DOCS=false
DISABLE_REDOC=false
